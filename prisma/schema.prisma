generator client {
 provider = "prisma-client"
 output = "../src/generated/prisma"
 moduleFormat = "esm"
}
datasource db {
 provider = "postgresql"
}

model Product {
 id String @id @default(uuid()) @db.Uuid
 slug String @unique
 title String
 description String
 status String @default("DRAFT")
 fabric String
 weave String @default("")
 colour String
 occasion String
 origin String @default("IN")
 care String
 lengthMm Int
 widthMm Int
 blouseIncluded Boolean @default(false)
 demo Boolean @default(true)
 version Int @default(1)
 images Json @default("[]")
 publishedAt DateTime? @db.Timestamptz
 variants Variant[]
 collections CollectionProduct[]
 reviews Review[]
 @@index([status, publishedAt])
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}

model Variant {
 id String @id @default(uuid()) @db.Uuid
 productId String @db.Uuid
 product Product @relation(fields:[productId], references:[id], onDelete:Restrict)
 sku String @unique
 title String
 optionSignature String
 active Boolean @default(true)
 weightG Int
 priceMinor BigInt
 currency String @default("LKR")
 exponent Int @default(2)
 version Int @default(1)
 balances InventoryBalance[]
 movements InventoryMovement[]
 cartItems CartItem[]
 orderLines OrderLine[]
 purchaseLines PurchaseLine[]
 @@unique([productId, optionSignature])
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}

model Collection {
 id String @id @default(uuid()) @db.Uuid
 slug String @unique
 title String
 description String
 image String
 status String @default("DRAFT")
 position Int @default(0)
 products CollectionProduct[]
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}

model CollectionProduct {
 id String @id @default(uuid()) @db.Uuid
 collectionId String @db.Uuid
 productId String @db.Uuid
 collection Collection @relation(fields:[collectionId],references:[id],onDelete:Restrict)
 product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
 position Int @default(0)
 @@unique([collectionId,productId])
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}

model Warehouse {
 id String @id @default(uuid()) @db.Uuid
 code String @unique
 name String
 active Boolean @default(true)
 balances InventoryBalance[]
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}
