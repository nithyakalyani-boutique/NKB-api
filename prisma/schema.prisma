generator client {
 provider = "prisma-client"
 output = "../src/generated/prisma"
 moduleFormat = "esm"
}
datasource db {
 provider = "postgresql"
}

model Product {
 id String @id @default(uuid()) @db.Uuid
 slug String @unique
 title String
 description String
 status String @default("DRAFT")
 fabric String
 weave String @default("")
 colour String
 occasion String
 origin String @default("IN")
 care String
 lengthMm Int
 widthMm Int
 blouseIncluded Boolean @default(false)
 demo Boolean @default(true)
 version Int @default(1)
 images Json @default("[]")
 publishedAt DateTime? @db.Timestamptz
 variants Variant[]
 collections CollectionProduct[]
 reviews Review[]
 @@index([status, publishedAt])
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}

model Variant {
 id String @id @default(uuid()) @db.Uuid
 productId String @db.Uuid
 product Product @relation(fields:[productId], references:[id], onDelete:Restrict)
 sku String @unique
 title String
 optionSignature String
 active Boolean @default(true)
 weightG Int
 priceMinor BigInt
 currency String @default("LKR")
 exponent Int @default(2)
 version Int @default(1)
 balances InventoryBalance[]
 movements InventoryMovement[]
 cartItems CartItem[]
 orderLines OrderLine[]
 purchaseLines PurchaseLine[]
 @@unique([productId, optionSignature])
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}

model Collection {
 id String @id @default(uuid()) @db.Uuid
 slug String @unique
 title String
 description String
 image String
 status String @default("DRAFT")
 position Int @default(0)
 products CollectionProduct[]
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}

model CollectionProduct {
 id String @id @default(uuid()) @db.Uuid
 collectionId String @db.Uuid
 productId String @db.Uuid
 collection Collection @relation(fields:[collectionId],references:[id],onDelete:Restrict)
 product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
 position Int @default(0)
 @@unique([collectionId,productId])
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}

model Warehouse {
 id String @id @default(uuid()) @db.Uuid
 code String @unique
 name String
 active Boolean @default(true)
 balances InventoryBalance[]
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}

model InventoryBalance {
 id String @id @default(uuid()) @db.Uuid
 variantId String @db.Uuid
 warehouseId String @db.Uuid
 variant Variant @relation(fields:[variantId],references:[id],onDelete:Restrict)
 warehouse Warehouse @relation(fields:[warehouseId],references:[id],onDelete:Restrict)
 onHand Int @default(0)
 reserved Int @default(0)
 version Int @default(1)
 @@unique([variantId,warehouseId])
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}

model InventoryMovement {
 id String @id @default(uuid()) @db.Uuid
 variantId String @db.Uuid
 variant Variant @relation(fields:[variantId],references:[id],onDelete:Restrict)
 warehouseId String @db.Uuid
 onHandDelta Int
 reservedDelta Int
 kind String
 sourceId String
 dedupeKey String @unique
 reason String
 actor String
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}

model Cart {
 id String @id @default(uuid()) @db.Uuid
 actor String
 userId String?
 currency String @default("LKR")
 status String @default("ACTIVE")
 version Int @default(1)
 coupon String?
 items CartItem[]
 quotes CheckoutSession[]
 order Order?
 @@index([actor,status])
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}

model CartItem {
 id String @id @default(uuid()) @db.Uuid
 cartId String @db.Uuid
 cart Cart @relation(fields:[cartId],references:[id],onDelete:Restrict)
 variantId String @db.Uuid
 variant Variant @relation(fields:[variantId],references:[id],onDelete:Restrict)
 quantity Int
 @@unique([cartId,variantId])
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}

model CheckoutSession {
 id String @id @default(uuid()) @db.Uuid
 cartId String @db.Uuid
 cart Cart @relation(fields:[cartId],references:[id],onDelete:Restrict)
 actor String
 cartVersion Int
 snapshot Json
 status String @default("OPEN")
 quoteExpiresAt DateTime @db.Timestamptz
 submittedAt DateTime? @db.Timestamptz
 termsVersion String?
 order Order?
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}

model Order {
 id String @id @default(uuid()) @db.Uuid
 reference String @unique
 cartId String @unique @db.Uuid
 cart Cart @relation(fields:[cartId],references:[id],onDelete:Restrict)
 checkoutId String @unique @db.Uuid
 checkout CheckoutSession @relation(fields:[checkoutId],references:[id],onDelete:Restrict)
 actor String
 userId String?
 email String
 address Json
 billingAddress Json
 currency String @default("LKR")
 exponent Int @default(2)
 subtotalMinor BigInt
 discountMinor BigInt
 shippingMinor BigInt
 taxMinor BigInt
 totalMinor BigInt
 snapshot Json
 status String @default("PENDING_PAYMENT")
 paymentSummary String @default("UNPAID")
 fulfillmentSummary String @default("UNFULFILLED")
 financialFlag String @default("NONE")
 fulfillmentException String?
 lines OrderLine[]
 attempts PaymentAttempt[]
 transactions PaymentTransaction[]
 shipments Shipment[]
 refunds Refund[]
 requests ServiceRequest[]
 @@index([actor,createdAt])
 @@index([userId,createdAt])
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}

model OrderLine {
 id String @id @default(uuid()) @db.Uuid
 orderId String @db.Uuid
 order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
 variantId String @db.Uuid
 variant Variant @relation(fields:[variantId],references:[id],onDelete:Restrict)
 title String
 sku String
 image String
 quantity Int
 unitPriceMinor BigInt
 discountMinor BigInt
 netMinor BigInt
 dispatched Int @default(0)
 cancelled Int @default(0)
 returned Int @default(0)
 costSnapshot Json
 reservations Reservation[]
 shipmentItems ShipmentItem[]
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}

model Reservation {
 id String @id @default(uuid()) @db.Uuid
 orderLineId String @db.Uuid
 orderLine OrderLine @relation(fields:[orderLineId],references:[id],onDelete:Restrict)
 variantId String @db.Uuid
 warehouseId String @db.Uuid
 quantity Int
 fulfilled Int @default(0)
 released Int @default(0)
 state String @default("ACTIVE")
 expiresAt DateTime? @db.Timestamptz
 closeReason String?
 @@index([state,expiresAt])
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}

model PaymentAttempt {
 id String @id @default(uuid()) @db.Uuid
 orderId String @db.Uuid
 order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
 provider String
 merchantReference String @unique
 amountMinor BigInt
 currency String
 status String @default("PENDING")
 transactions PaymentTransaction[]
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}

model PaymentEvent {
 id String @id @default(uuid()) @db.Uuid
 dedupeKey String @unique
 attemptId String @db.Uuid
 payloadHash String
 status String
 verified Boolean
 processedAt DateTime? @db.Timestamptz
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}

model PaymentTransaction {
 id String @id @default(uuid()) @db.Uuid
 orderId String @db.Uuid
 order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
 attemptId String @db.Uuid
 attempt PaymentAttempt @relation(fields:[attemptId],references:[id],onDelete:Restrict)
 kind String
 amountMinor BigInt
 currency String
 providerReference String @unique
 originalId String?
 @@index([orderId,kind])
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}

model Refund {
 id String @id @default(uuid()) @db.Uuid
 orderId String @db.Uuid
 order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
 attemptId String @db.Uuid
 amountMinor BigInt
 currency String
 status String @default("REQUESTED")
 reason String
 operationKey String @unique
 allocations Json
 providerReference String? @unique
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}

model ReconciliationIssue {
 id String @id @default(uuid()) @db.Uuid
 orderId String @db.Uuid
 attemptId String? @db.Uuid
 code String
 requiredRefundMinor BigInt?
 state String @default("OPEN")
 evidence Json
 dueAt DateTime @db.Timestamptz
 @@index([state,dueAt])
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}

model Shipment {
 id String @id @default(uuid()) @db.Uuid
 orderId String @db.Uuid
 order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
 carrier String
 trackingNumber String
 status String @default("READY")
 operationKey String @unique
 costMinor BigInt?
 currency String @default("LKR")
 dispatchedAt DateTime? @db.Timestamptz
 items ShipmentItem[]
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}

model ShipmentItem {
 id String @id @default(uuid()) @db.Uuid
 shipmentId String @db.Uuid
 shipment Shipment @relation(fields:[shipmentId],references:[id],onDelete:Restrict)
 orderLineId String @db.Uuid
 orderLine OrderLine @relation(fields:[orderLineId],references:[id],onDelete:Restrict)
 quantity Int
 @@unique([shipmentId,orderLineId])
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
}
